        "selector": "JSXOpeningElement[name.name='ValueCapsule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sky|navy)$/]",
        "message": "<ValueCapsule> tone must be one of 'sky' | 'navy'."
