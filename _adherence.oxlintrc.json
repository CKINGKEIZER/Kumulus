      {
        "selector": "JSXOpeningElement[name.name='VerticalTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|width|height|className|style|key|ref|className|style|children)$/]",
        "message": "<VerticalTab> doesn't accept that prop. Declared props: label, width, height, className, style."
      }
    ]
  },
