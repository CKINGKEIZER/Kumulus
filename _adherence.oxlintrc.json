{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/charts/**",
              "components/content/**",
              "components/data/**",
              "components/diagrams/**",
              "components/feature/**",
              "components/layout/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Sans Pro|Merriweather))/i]",
        "message": "Font not provided by the design system. Available: Source Sans Pro, Merriweather."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowConnector'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|size|className|style|key|ref|className|style|children)$/]",
        "message": "<ArrowConnector> doesn't accept that prop. Declared props: direction, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowConnector'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:down|right)$/]",
        "message": "<ArrowConnector> direction must be one of 'down' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|display|labelWidth|barColor|capsuleTone|className|style|key|ref|className|style|children)$/]",
        "message": "<BarRow> doesn't accept that prop. Declared props: label, value, max, display, labelWidth, barColor, capsuleTone, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarRow'] > JSXAttribute[name.name='capsuleTone'] > Literal[value!=/^(?:sky|navy)$/]",
        "message": "<BarRow> capsuleTone must be one of 'sky' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|size|dense|className|style|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, size, dense, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<BulletList> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CagrPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|style|key|ref|className|style|children)$/]",
        "message": "<CagrPill> doesn't accept that prop. Declared props: value, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|segments|key|ref|className|style|children)$/]",
        "message": "<ColumnDatum> doesn't accept that prop. Declared props: label, value, segments."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|rule|align|className|style|key|ref|className|style|children)$/]",
        "message": "<ColumnHeading> doesn't accept that prop. Declared props: children, icon, rule, align, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<ColumnHeading> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HarveyBall'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|size|color|style|key|ref|className|style|children)$/]",
        "message": "<HarveyBall> doesn't accept that prop. Declared props: level, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|color|key|ref|className|style|children)$/]",
        "message": "<DonutSegment> doesn't accept that prop. Declared props: value, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='FinancialRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|values|bold|subtotal|indent|italic|marker|key|ref|className|style|children)$/]",
        "message": "<FinancialRow> doesn't accept that prop. Declared props: label, values, bold, subtotal, indent, italic, marker."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|label|key|ref|className|style|children)$/]",
        "message": "<FooterTab> doesn't accept that prop. Declared props: n, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyMessageBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|style|key|ref|className|style|children)$/]",
        "message": "<KeyMessageBand> doesn't accept that prop. Declared props: children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|sublabel|icon|align|size|className|style|key|ref|className|style|children)$/]",
        "message": "<KpiCell> doesn't accept that prop. Declared props: value, label, sublabel, icon, align, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCell'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<KpiCell> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCell'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<KpiCell> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|width|align|key|ref|className|style|children)$/]",
        "message": "<KpiTableColumn> doesn't accept that prop. Declared props: label, width, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<KpiTableColumn> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KumulusMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|color|className|style|key|ref|className|style|children)$/]",
        "message": "<KumulusMark> doesn't accept that prop. Declared props: height, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedHighlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|icon|bullets|visual|className|style|key|ref|className|style|children)$/]",
        "message": "<NumberedHighlight> doesn't accept that prop. Declared props: number, title, icon, bullets, visual, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|trailing|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<PanelHeader> doesn't accept that prop. Declared props: children, trailing, tone, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:grey|plain)$/]",
        "message": "<PanelHeader> tone must be one of 'grey' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessStepItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|body|key|ref|className|style|children)$/]",
        "message": "<ProcessStepItem> doesn't accept that prop. Declared props: label, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<ProcessStep> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|role|avatarSrc|variant|className|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: quote, author, role, avatarSrc, variant, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|card|testimonial)$/]",
        "message": "<PullQuote> variant must be one of 'plain' | 'card' | 'testimonial'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PyramidTier'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<PyramidTier> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|trailing|variant|height|className|style|key|ref|className|style|children)$/]",
        "message": "<SectionBar> doesn't accept that prop. Declared props: label, icon, trailing, variant, height, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionBar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bar|chevron)$/]",
        "message": "<SectionBar> variant must be one of 'bar' | 'chevron'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|subtitle|band|titleLogoSrc|titleLogoAlt|showTitleLogo|children|projectName|confidential|note|sectionTabs|activeTab|activeLabel|pageNumber|targetLogoSrc|targetLogoAlt|showFooterTargetLogo|backgroundSrc|sectionNumber|coverImageSrc|coverTitle|coverDate|sections|activeSection|className|style|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: variant, title, subtitle, band, titleLogoSrc, titleLogoAlt, showTitleLogo, children, projectName, confidential, note, sectionTabs, activeTab, activeLabel, pageNumber, targetLogoSrc, targetLogoAlt, showFooterTargetLogo, backgroundSrc, sectionNumber, coverImageSrc, coverTitle, coverDate, sections, activeSection, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:content|cover|divider)$/]",
        "message": "<SlideFrame> variant must be one of 'content' | 'cover' | 'divider'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TargetCompanyLogoPlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|height|label|className|style|key|ref|className|style|children)$/]",
        "message": "<TargetCompanyLogoPlaceholder> doesn't accept that prop. Declared props: variant, width, height, label, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TargetCompanyLogoPlaceholder'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:cover-large|header-medium|footer-small|diagram-node)$/]",
        "message": "<TargetCompanyLogoPlaceholder> variant must be one of 'cover-large' | 'header-medium' | 'footer-small' | 'diagram-node'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelinePhase'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|flex|key|ref|className|style|children)$/]",
        "message": "<TimelinePhase> doesn't accept that prop. Declared props: label, flex."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValueCapsule'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<ValueCapsule> doesn't accept that prop. Declared props: children, tone, className, style."
